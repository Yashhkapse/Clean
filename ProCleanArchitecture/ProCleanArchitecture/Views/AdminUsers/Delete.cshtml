@model UserDetailsViewModel
@{
    ViewData["Title"] = "Delete User";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-page-title">Delete User</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="admin-card">
    <div class="alert alert-warning">This action will permanently delete @Model.FullName.</div>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.Role</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-danger" type="submit">Delete User</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div>

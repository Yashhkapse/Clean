@model UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-page-title">User Details</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="admin-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@Model.Role</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
        <dt class="col-sm-3">Updated</dt>
        <dd class="col-sm-9">@(Model.UpdatedAtUtc.HasValue ? Model.UpdatedAtUtc.Value.ToLocalTime().ToString("g") : "Not updated")</dd>
    </dl>
</div>

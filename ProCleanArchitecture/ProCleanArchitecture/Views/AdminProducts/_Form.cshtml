@model ProductFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="row g-3">
    <div class="col-lg-8">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="col-lg-4">
        <label class="form-label" asp-for="Price"></label>
        <input class="form-control" asp-for="Price" />
        <span class="text-danger" asp-validation-for="Price"></span>
    </div>
    <div class="col-12">
        <label class="form-label" asp-for="Description"></label>
        <textarea class="form-control" asp-for="Description" rows="4"></textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="CategoryId"></label>
        <select class="form-select" asp-for="CategoryId" asp-items="Model.Categories">
            <option value="">Select category</option>
        </select>
        <span class="text-danger" asp-validation-for="CategoryId"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="Type"></label>
        <select class="form-select" asp-for="Type" asp-items="Html.GetEnumSelectList<ProductType>()"></select>
        <span class="text-danger" asp-validation-for="Type"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="Status"></label>
        <select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<ProductStatus>()"></select>
        <span class="text-danger" asp-validation-for="Status"></span>
    </div>
</div>

@model ProductDetailsViewModel
@{
    ViewData["Title"] = "Delete Product";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="admin-page-title">Delete Product</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="admin-card">
    <div class="alert alert-warning">This action will permanently delete @Model.Name.</div>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.CategoryName</dd>
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-danger" type="submit">Delete Product</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </form>
</div>
